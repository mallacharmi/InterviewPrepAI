# ==================================================
# AI Interview Preparation System
# Environment Variables
# ==================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control
# ==================================================

# Server
SERVER_PORT=8080

# Database (MySQL - for production/docker)
DB_URL=jdbc:mysql://localhost:3306/interview_prep_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# AI Provider (OpenAI-compatible API)
AI_API_KEY=your_api_key_here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-3.5-turbo
AI_TIMEOUT=30
AI_MAX_RETRIES=3
AI_MAX_FOLLOW_UPS=1

# Spring Profile (dev uses H2, prod uses MySQL)
SPRING_PROFILES_ACTIVE=dev
